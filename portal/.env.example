# Create a Google OAuth 2.0 Web application client. Never use NEXT_PUBLIC_ here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_ORIGIN=http://127.0.0.1:3000
# Optional independent data location (contains encrypted tokens and workflow metadata):
# GOOGLE_DATA_DIR=/absolute/private/path
# Seconds between background reply collection runs; 0 disables background collection.
GOOGLE_POLL_INTERVAL_SECONDS=60

# Five-member shared workspace: first administrator's Google email.
# Only used when the members database is empty. Other members are added at /members.
PORTAL_ADMIN_EMAIL=
# Optional separate OAuth client for personal sign-in. Otherwise GOOGLE_CLIENT_ID/SECRET
# (or the existing imported client) is reused. Register /api/auth/callback as well
# as /api/google/callback on the appropriate OAuth clients.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
